[Unit]
Description=Weekly (Mon 00:00) Pika backup sync to cloud storage - pika-cloud-sync.service

[Timer]
Unit=pika-cloud-sync.service
# Triggers Monday 00:00 local time ± 1 min accuracy + up to 1 h random delay.
# If the host timezone changes, the effective UTC window shifts accordingly.
OnCalendar=weekly
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target

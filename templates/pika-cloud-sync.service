[Unit]
Description=Weekly Pika Backup Sync to Cloud Storage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{DETECTED_USER}}
Nice=19
IOSchedulingClass=idle
# Take a read-only snapshot of the backup drive to ensure Borg repo consistency
ExecStartPre=+/usr/bin/btrfs subvolume snapshot -r "{{BACKUP_MOUNT}}" "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
# Note: 'rclone copy' is used instead of 'sync' for offsite backups to prevent
# accidental local deletions or repo pruning from destroying cloud data.
ExecStart=/usr/bin/rclone copy "{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal" "{{CLOUD_REMOTE}}{{CLOUD_PIKA_DIR}}" -v
# Clean up the snapshot
ExecStopPost=+/usr/bin/btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"

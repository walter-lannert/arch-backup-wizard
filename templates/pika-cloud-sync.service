[Unit]
Description=Weekly Pika Backup Sync to Cloud Storage
Requires=network-online.target
After=network-online.target
RequiresMountsFor={{BACKUP_MOUNT}}

[Service]
Type=oneshot
TimeoutStartSec=infinity
User={{DETECTED_USER}}
Nice=19
IOSchedulingClass=idle
# Ensure any stale snapshots from previous hard crashes are destroyed first
ExecStartPre=+/usr/bin/sh -c 'if [ -e "{{BACKUP_MOUNT}}/.pika_sync_snapshot" ]; then if btrfs subvolume list "{{BACKUP_MOUNT}}" 2>/dev/null | grep -qF ".pika_sync_snapshot"; then btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"; else echo "FATAL: .pika_sync_snapshot exists but is not a btrfs subvolume; manual intervention required" >&2; exit 1; fi; fi'
# Take a read-only snapshot of the backup drive to ensure Borg repo consistency
ExecStartPre=+/usr/bin/btrfs subvolume snapshot -r "{{BACKUP_MOUNT}}" "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
# Guard: abort sync before invoking rclone if the Borg repository is missing or invalid
ExecStartPre=/usr/bin/sh -c 'REPO="{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal"; test -d "$REPO" || { echo "FATAL: Borg repo directory $REPO not found in snapshot" >&2; exit 1; }; test -f "$REPO/config" && test -f "$REPO/chunks" || { echo "FATAL: $REPO does not look like a valid Borg repository (missing config/chunks)" >&2; exit 1; }; test -n "$(/usr/bin/ls -A "$REPO" 2>/dev/null)" || { echo "FATAL: Borg repo $REPO is empty" >&2; exit 1; }'
# Note: 'rclone sync' is strictly required for Borg repositories to ensure
# rolling chunk compaction and index integrity. 'rclone copy' corrupts Borg.
ExecStart=/usr/bin/rclone sync "{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal" "{{CLOUD_REMOTE}}{{CLOUD_PIKA_DIR}}" -v --max-delete 100 --checksum --bwlimit 50M
# Clean up the snapshot (success path)
ExecStartPost=-+/usr/bin/btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
# Clean up the snapshot (failure path)
ExecStopPost=-+/usr/bin/btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"

[Unit]
Description=Weekly Pika Backup Sync to Cloud Storage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# Note: 'rclone sync' will delete files on the remote that have been deleted locally,
# keeping the cloud backup as an exact mirror of the local Pika repository.
ExecStart=/usr/bin/rclone sync "{{BACKUP_MOUNT}}/Personal" "{{CLOUD_REMOTE}}{{CLOUD_PIKA_DIR}}" -v

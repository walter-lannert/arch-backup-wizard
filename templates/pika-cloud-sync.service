[Unit]
Description=Weekly Pika Backup Sync to Cloud Storage
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{SYSTEMD_BACKUP_MOUNT}}

[Service]
Type=oneshot
User={{DETECTED_USER}}
Nice=19
IOSchedulingClass=idle
# Ensure any stale snapshots from previous hard crashes are destroyed first
ExecStartPre=-+/usr/bin/btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
# Take a read-only snapshot of the backup drive to ensure Borg repo consistency
ExecStartPre=+/usr/bin/btrfs subvolume snapshot -r "{{BACKUP_MOUNT}}" "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
# Guard: abort sync before invoking rclone if the Borg repository is missing or empty
ExecStartPre=/usr/bin/sh -c 'test -d "{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal" && test -n "$(/usr/bin/ls -A "{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal" 2>/dev/null)"'
# Note: 'rclone sync' is strictly required for Borg repositories to ensure
# rolling chunk compaction and index integrity. 'rclone copy' corrupts Borg.
ExecStart=/usr/bin/rclone sync "{{BACKUP_MOUNT}}/.pika_sync_snapshot/Personal" "{{CLOUD_REMOTE}}{{CLOUD_PIKA_DIR}}" -v
# Clean up the snapshot
ExecStopPost=-+/usr/bin/btrfs subvolume delete "{{BACKUP_MOUNT}}/.pika_sync_snapshot"
